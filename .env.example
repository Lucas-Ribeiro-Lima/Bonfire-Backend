# ==========================================
# Database Configuration
# ==========================================
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bonfire
DB_USER=bonfire
DB_PASSWORD=change_this_to_your_db_password

# ==========================================
# Keycloak Authentication Configuration (OIDC)
# ==========================================
KEYCLOAK_ISSUER=http://localhost:8080
KEYCLOAK_REALM_NAME=bonfire
KEYCLOAK_CLIENT_ID=bonfire
KEYCLOAK_CLIENT_SECRET=change_this_to_your_client_secret
